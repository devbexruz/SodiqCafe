<!-- ============================================================
     STYLES
============================================================ -->
<style>
    /* ---------- Global ---------- */
    :root {
        --brand: #0d6efd;
        --brand-2: #6610f2;
        --brand-grad: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
    }

    body {
        font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
        overflow-x: hidden;
    }

    .section {
        padding: 90px 0;
        position: relative;
    }

    /* ---------- Section Head ---------- */
    .section-head {
        margin-bottom: 60px;
    }

    .section-eyebrow {
        display: inline-block;
        padding: 6px 16px;
        background: rgba(13, 110, 253, 0.1);
        color: var(--brand);
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 50px;
        letter-spacing: 0.5px;
        margin-bottom: 14px;
    }

    .section-eyebrow.eyebrow-light {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(6px);
    }

    .section-title {
        font-size: clamp(1.75rem, 3.5vw, 2.75rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 14px;
    }

    .section-desc {
        color: #6c757d;
        max-width: 620px;
        margin: 0 auto;
        font-size: 1.05rem;
    }

    .gradient-text {
        background: var(--brand-grad);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* ---------- Buttons ---------- */
    .btn-brand {
        background: var(--brand-grad);
        color: #fff;
        border: none;
        border-radius: 50px;
        padding: 14px 36px;
        font-weight: 700;
        box-shadow: 0 12px 30px -10px rgba(13, 110, 253, 0.6);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .btn-brand:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 18px 40px -12px rgba(13, 110, 253, 0.75);
    }

    .btn-ghost {
        background: #fff;
        color: #212529;
        border: 2px solid #e9ecef;
        border-radius: 50px;
        padding: 12px 32px;
        font-weight: 700;
        transition: all 0.25s ease;
    }

    .btn-ghost:hover {
        color: var(--brand);
        border-color: var(--brand);
        transform: translateY(-2px);
    }

    /* ============================================================
       HERO
    ============================================================ */
    .hero-section {
        padding: 100px 0 90px;
        background:
            radial-gradient(circle at 10% 20%, rgba(13, 110, 253, 0.12) 0%, transparent 45%),
            radial-gradient(circle at 90% 80%, rgba(102, 16, 242, 0.10) 0%, transparent 45%),
            linear-gradient(180deg, #f8f9ff 0%, #ffffff 100%);
        position: relative;
        overflow: hidden;
    }

    .hero-title {
        font-size: clamp(2rem, 5.5vw, 3.75rem);
        font-weight: 800;
        line-height: 1.15;
        color: #0b1220;
    }

    .hero-subtitle {
        font-size: 1.15rem;
        color: #5a6473;
        max-width: 720px;
        line-height: 1.7;
    }

    .pill-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 20px;
        background: #fff;
        color: var(--brand);
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 8px 24px -12px rgba(13, 110, 253, 0.45);
        border: 1px solid rgba(13, 110, 253, 0.15);
    }

    .dot-pulse {
        width: 8px;
        height: 8px;
        background: var(--brand);
        border-radius: 50%;
        position: relative;
    }

    .dot-pulse::after {
        content: "";
        position: absolute;
        inset: -4px;
        border-radius: 50%;
        border: 2px solid var(--brand);
        animation: pulseRing 1.8s ease-out infinite;
    }

    @@keyframes pulseRing {
        0% { transform: scale(0.7); opacity: 1; }
        100% { transform: scale(1.8); opacity: 0; }
    }

    /* ============================================================
       FEATURES
    ============================================================ */
    .features-section {
        background: #fff;
    }

    .feature-card {
        background: #fff;
        border: 1px solid #eef0f5;
        border-radius: 24px;
        padding: 44px 32px;
        text-align: center;
        transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
        position: relative;
        overflow: hidden;
    }

    .feature-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--brand-grad);
        opacity: 0;
        transition: opacity 0.35s ease;
        z-index: 0;
    }

    .feature-card > * {
        position: relative;
        z-index: 1;
    }

    .feature-card:hover {
        transform: translateY(-8px);
        border-color: transparent;
        box-shadow: 0 30px 60px -20px rgba(13, 110, 253, 0.35);
    }

    .feature-icon {
        font-size: 3rem;
        margin-bottom: 20px;
        display: inline-block;
        transition: transform 0.35s ease;
    }

    .feature-card:hover .feature-icon {
        transform: scale(1.1) rotate(-5deg);
    }

    /* ============================================================
       HOW IT WORKS
    ============================================================ */
    .how-section {
        background: linear-gradient(135deg, #0a1e5e 0%, #0d6efd 55%, #6610f2 100%);
        color: #fff;
        overflow: hidden;
    }

    .how-section::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 15% 20%, rgba(255, 255, 255, 0.12) 0%, transparent 45%),
            radial-gradient(circle at 85% 80%, rgba(255, 255, 255, 0.10) 0%, transparent 45%);
        pointer-events: none;
    }

    .how-section::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.15) 1px, transparent 1px);
        background-size: 22px 22px;
        opacity: 0.35;
        pointer-events: none;
    }

    .how-section .container {
        position: relative;
        z-index: 1;
    }

    .how-wrapper {
        position: relative;
        padding-top: 20px;
    }

    /* Horizontal dashed line */
    .how-wrapper::before {
        content: "";
        position: absolute;
        top: 45px;
        left: 12.5%;
        right: 12.5%;
        height: 2px;
        background: repeating-linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.55) 0px,
            rgba(255, 255, 255, 0.55) 8px,
            transparent 8px,
            transparent 16px
        );
    }

    .how-item {
        position: relative;
        z-index: 1;
    }

    .how-circle {
        width: 90px;
        height: 90px;
        margin: 0 auto;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.10);
        backdrop-filter: blur(10px);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid rgba(255, 255, 255, 0.35);
        box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.45),
                    inset 0 0 0 1px rgba(255, 255, 255, 0.25);
        position: relative;
        transition: transform 0.35s ease, background 0.35s ease, border-color 0.35s ease;
    }

    .how-circle span {
        font-size: 1.9rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
    }

    .how-circle::after {
        content: "";
        position: absolute;
        inset: -9px;
        border-radius: 50%;
        border: 2px dashed rgba(255, 255, 255, 0.35);
        animation: spin 22s linear infinite;
    }

    .how-item:hover .how-circle {
        transform: translateY(-6px) scale(1.06);
        background: rgba(255, 255, 255, 0.20);
        border-color: #fff;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* ============================================================
       STEPS (O'RNATISH)
    ============================================================ */
    .steps-section {
        background: linear-gradient(180deg, #ffffff 0%, #f8f9ff 100%);
    }

    .steps-wrapper {
        max-width: 1100px;
        margin: 0 auto;
    }

    .step-item {
        position: relative;
    }

    .step-content {
        padding: 10px 20px;
    }

    .step-visual {
        position: relative;
        display: inline-block;
    }

    .step-icon-card {
        background: #fff;
        border-radius: 24px;
        padding: 45px 60px;
        box-shadow: 0 25px 60px -25px rgba(13, 110, 253, 0.35);
        border: 1px solid rgba(13, 110, 253, 0.08);
        transition: transform 0.35s ease, box-shadow 0.35s ease;
        text-align: center;
    }

    .step-icon-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 35px 70px -25px rgba(13, 110, 253, 0.5);
    }

    .step-icon-label {
        font-size: 0.95rem;
        font-weight: 700;
        margin-top: 8px;
        color: #212529;
    }

    .step-number {
        position: absolute;
        top: -22px;
        right: -22px;
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: var(--brand-grad);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        font-weight: 800;
        box-shadow: 0 10px 25px -5px rgba(13, 110, 253, 0.6);
        border: 4px solid #fff;
        z-index: 2;
    }

    .step-number::after {
        content: "";
        position: absolute;
        inset: -8px;
        border-radius: 50%;
        border: 2px dashed rgba(13, 110, 253, 0.4);
        animation: spin 18s linear infinite;
    }

    /* ---------- Vertical Connector ---------- */
    .step-connector {
        position: relative;
        width: 100%;
        height: 90px;
        margin: -10px 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        pointer-events: none;
    }

    .step-connector::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        background: linear-gradient(
            180deg,
            rgba(13, 110, 253, 0) 0%,
            rgba(13, 110, 253, 0.45) 25%,
            rgba(102, 16, 242, 0.45) 75%,
            rgba(102, 16, 242, 0) 100%
        );
    }

    .step-connector .dot {
        position: relative;
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--brand-grad);
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.12);
        animation: dotPulse 1.8s ease-in-out infinite;
    }

    .step-connector .dot:nth-child(2) { animation-delay: 0.3s; }
    .step-connector .dot:nth-child(3) { animation-delay: 0.6s; }

    @@keyframes dotPulse {
        0%, 100% {
            transform: scale(1);
            opacity: 0.45;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.10);
        }
        50% {
            transform: scale(1.35);
            opacity: 1;
            box-shadow: 0 0 0 8px rgba(13, 110, 253, 0.18);
        }
    }

    /* ============================================================
       PRICING
    ============================================================ */
    .pricing-section {
        background: #f8f9fc;
    }

    .price-card {
        background: #fff;
        border-radius: 24px;
        padding: 40px 32px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 15px 40px -20px rgba(13, 110, 253, 0.15);
        border: 1px solid #eef0f5;
        transition: transform 0.35s ease, box-shadow 0.35s ease;
        position: relative;
    }

    .price-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 30px 60px -25px rgba(13, 110, 253, 0.35);
    }

    .popular-card {
        border: 2px solid var(--brand);
        box-shadow: 0 30px 70px -25px rgba(13, 110, 253, 0.5);
    }

    .popular-badge {
        position: absolute;
        top: -14px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--brand-grad);
        color: #fff;
        padding: 6px 18px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        box-shadow: 0 10px 20px -8px rgba(13, 110, 253, 0.6);
        white-space: nowrap;
    }

    .price-head {
        text-align: center;
        margin-bottom: 24px;
    }

    .price-value {
        font-size: 2.25rem;
        font-weight: 800;
        color: #0b1220;
        line-height: 1.1;
    }

    .price-list {
        list-style: none;
        padding: 0;
        margin: 0 0 28px 0;
        color: #5a6473;
    }

    .price-list li {
        padding: 8px 0 8px 28px;
        position: relative;
        font-size: 0.95rem;
    }

    .price-list li::before {
        content: "\F26A"; font-family: "bootstrap-icons";
        position: absolute;
        left: 0;
        top: 8px;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(13, 110, 253, 0.12);
        color: var(--brand);
        border-radius: 50%;
        font-size: 0.75rem;
        font-weight: 900;
    }

    .example-chip {
        background: #fff;
        color: #212529;
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 0.9rem;
        font-weight: 600;
        box-shadow: 0 6px 20px -10px rgba(0, 0, 0, 0.15);
    }

    /* ============================================================
       CONTACT
    ============================================================ */
    .contact-section {
        background:
            radial-gradient(circle at 20% 30%, rgba(13, 110, 253, 0.25) 0%, transparent 50%),
            radial-gradient(circle at 80% 70%, rgba(102, 16, 242, 0.20) 0%, transparent 50%),
            #0b1220;
        color: #fff;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 18px;
        font-size: 1.05rem;
    }

    .contact-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--brand-grad);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
        box-shadow: 0 10px 25px -10px rgba(13, 110, 253, 0.7);
    }

    .contact-form-card {
        background: #fff;
        color: #212529;
        border-radius: 24px;
        padding: 40px 36px;
        box-shadow: 0 30px 80px -25px rgba(0, 0, 0, 0.6);
    }

    .contact-form-card .form-control:focus {
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.2);
        background: #fff !important;
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @@media (max-width: 991px) {
        .how-wrapper::before { display: none; }
        .section { padding: 70px 0; }
    }

    @@media (max-width: 768px) {
        .hero-section { padding: 70px 0 60px; }
        .section { padding: 60px 0; }

        .how-circle {
            width: 72px;
            height: 72px;
        }
        .how-circle span { font-size: 1.5rem; }
        .how-circle::after { inset: -7px; }

        .step-icon-card {
            padding: 32px 40px;
        }

        .step-number {
            width: 56px;
            height: 56px;
            font-size: 1.25rem;
            top: -16px;
            right: -16px;
            border-width: 3px;
        }

        .contact-form-card { padding: 30px 22px; }
        .price-card { padding: 32px 24px; }
    }
    a {
        text-decoration: none;
    }
</style>


<!-- ============================================================
     USD -> UZS CONVERTER
============================================================ -->
<script>
    const usdToUzsRate = @usdToUzsRate;

    function formatUZS(amount) {
        return new Intl.NumberFormat('uz-UZ').format(Math.round(amount)) + " so‘m";
    }

    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".uzs-price").forEach(function (element) {
            const usd = parseFloat(element.dataset.usd);
            if (!isNaN(usd) && usdToUzsRate > 0) {
                element.textContent = "≈ " + formatUZS(usd * usdToUzsRate);
            }
        });
    });
</script>