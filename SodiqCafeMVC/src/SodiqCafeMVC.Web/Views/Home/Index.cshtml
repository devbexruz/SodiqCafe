@{
    ViewData["Title"] = "Kafe egalari uchun platforma";
    var usdToUzsRate = ViewData["UsdToUzsRate"] ?? 11800;
}

<!-- ============================================================
     HERO
============================================================ -->
<section class="hero-section">
    <div class="container">
        <div class="text-center">

            <span class="pill-badge mb-3">
                <span class="dot-pulse"></span>
                Restoran va Kafelar uchun
            </span>

            <h1 class="hero-title mb-4">
                Mijozlaringizni
                <span class="gradient-text">sodiq mijozlarga</span>
                aylantiring
            </h1>

            <p class="hero-subtitle mx-auto mb-5">
                SodiqCafe — kafeingiz uchun zamonaviy raqamli menyu,
                NFC va QR orqali tezkor kirish, Telegram bot va mijozlar
                sodiqligi tizimini birlashtirgan platforma.
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a href="#contact" class="btn btn-brand btn-lg">
                    <i class="bi bi-rocket-takeoff-fill me-2"></i> Hoziroq boshlash
                </a>
                <a href="#how-it-works" class="btn btn-ghost btn-lg">
                    Batafsil ma'lumot
                </a>
            </div>

        </div>
    </div>
</section>


<!-- ============================================================
     IMKONIYATLAR
============================================================ -->
<section class="section features-section">
    <div class="container">

        <div class="section-head text-center">
            <span class="section-eyebrow">Imkoniyatlar</span>
            <h2 class="section-title">Nega aynan <span class="gradient-text">SodiqCafe</span>?</h2>
            <p class="section-desc">
                Mijozga qulaylik, kafe egasiga esa zamonaviy boshqaruv.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon"><i class="bi bi-qr-code-scan"></i></div>
                    <h4 class="fw-bold mb-3">NFC orqali menyu</h4>
                    <p class="text-muted mb-0">
                        Mijoz telefonini stolga o‘rnatilgan NFC belgiga
                        tekkizadi va menyu bir zumda ochiladi.
                        QR kod skanerlash shart emas.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon"><i class="bi bi-telegram"></i></div>
                    <h4 class="fw-bold mb-3">Telegram Bot</h4>
                    <p class="text-muted mb-0">
                        Telegram bot barcha tariflarda mavjud.
                        Mijozlar menyuni ko‘rishi, buyurtma berishi
                        va kerakli ma'lumotlarni Telegram orqali olishi mumkin.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon"><i class="bi bi-gift-fill"></i></div>
                    <h4 class="fw-bold mb-3">Cashback & Bonuslar</h4>
                    <p class="text-muted mb-0">
                        Mijozlarning xaridlarini hisobga oling,
                        ularga bonus va cashback taqdim eting
                        hamda qayta tashriflarni rag‘batlantiring.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ============================================================
     QANDAY ISHLAYDI
============================================================ -->
<section id="how-it-works" class="section how-section">
    <div class="container">

        <div class="section-head text-center">
            <span class="section-eyebrow eyebrow-light">Ishlash tartibi</span>
            <h2 class="section-title text-white">
                Tizim <span class="how-accent">qanday ishlaydi?</span>
            </h2>
            <p class="section-desc how-desc">
                Mijoz uchun 4 qulay qadam — NFC yoki QR kod orqali buyurtmagacha.
            </p>
        </div>

        <div class="how-wrapper">
            <div class="row g-4 justify-content-center">

                <!-- 1 -->
                <div class="col-md-3 col-6 text-center how-item">
                    <div class="how-circle"><span>1</span></div>
                    <h5 class="how-title">NFC yoki QR</h5>
                    <p class="how-text">
                        Mijoz telefonini NFC belgiga tekkizadi
                        yoki QR kodni skanerlaydi.
                    </p>
                </div>

                <!-- 2 -->
                <div class="col-md-3 col-6 text-center how-item">
                    <div class="how-circle"><span>2</span></div>
                    <h5 class="how-title">Menyu ochiladi</h5>
                    <p class="how-text">
                        Hech qanday ilova o‘rnatmasdan,
                        brauzerda raqamli menyu ochiladi.
                    </p>
                </div>

                <!-- 3 -->
                <div class="col-md-3 col-6 text-center how-item">
                    <div class="how-circle"><span>3</span></div>
                    <h5 class="how-title">Buyurtma</h5>
                    <p class="how-text">
                        Mijoz menyuni ko‘radi va Telegram bot
                        yoki buyurtma tizimi orqali buyurtma beradi.
                    </p>
                </div>

                <!-- 4 -->
                <div class="col-md-3 col-6 text-center how-item">
                    <div class="how-circle"><span>4</span></div>
                    <h5 class="how-title">Qaytib kelish</h5>
                    <p class="how-text">
                        Bonuslar va qulay xizmat mijozni
                        kafengizga yana qaytishga undaydi.
                    </p>
                </div>

            </div>
        </div>
    </div>
</section>


<style>
    /* ============================================================
       HOW SECTION — TO'Q VA ANIQ KO'RINADIGAN
    ============================================================ */
    .how-section {
        position: relative;
        overflow: hidden;
        /* To'qroq, chuqurroq gradient — kontrast yaxshi */
        background:
            radial-gradient(circle at 15% 15%, rgba(13, 110, 253, 0.22) 0%, transparent 45%),
            radial-gradient(circle at 85% 85%, rgba(102, 16, 242, 0.18) 0%, transparent 45%),
            linear-gradient(135deg, #0a1533 0%, #101a4a 50%, #1a1260 100%);
        color: #fff;
    }

    /* Nozik nuqtali naqsh (juda yengil) */
    .how-section::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
        background-size: 26px 26px;
        pointer-events: none;
        z-index: 0;
    }

    .how-section .container {
        position: relative;
        z-index: 1;
    }

    /* ---------- Badge ---------- */
    .section-eyebrow.eyebrow-light {
        display: inline-block;
        padding: 8px 20px;
        background: rgba(255, 255, 255, 0.10);
        color: #fff;
        font-weight: 600;
        font-size: 0.85rem;
        border-radius: 50px;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        border: 1px solid rgba(255, 255, 255, 0.22);
        backdrop-filter: blur(6px);
    }

    /* ---------- Sarlavha ---------- */
    .how-section .section-title {
        font-size: clamp(1.75rem, 3.5vw, 2.75rem);
        font-weight: 800;
        line-height: 1.2;
        color: #ffffff !important;
        margin-bottom: 14px;
        text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
    }

    /* "qanday ishlaydi?" uchun yorqinroq rang */
    .how-accent {
        color: #ffd166;
        text-shadow: 0 0 30px rgba(255, 209, 102, 0.5);
    }

    /* ---------- Tavsif ---------- */
    .how-desc {
        color: rgba(255, 255, 255, 0.82) !important;
        max-width: 620px;
        margin: 0 auto;
        font-size: 1.05rem;
        line-height: 1.7;
        font-weight: 400;
    }

    /* ============================================================
       WRAPPER + GORIZONTAL CHIZIQ
    ============================================================ */
    .how-wrapper {
        position: relative;
        padding-top: 20px;
    }

    .how-wrapper::before {
        content: "";
        position: absolute;
        margin-top: 20pxad;
        top: 45px;
        left: 12.5%;
        right: 12.5%;
        height: 2px;
        background: repeating-linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.45) 0px,
            rgba(255, 255, 255, 0.45) 8px,
            transparent 8px,
            transparent 16px
        );
        z-index: 0;
    }

    .how-item {
        position: relative;
        z-index: 1;
    }

    /* ============================================================
       RAQAMLI DOIRA
    ============================================================ */
    .how-circle {
        width: 90px;
        height: 90px;
        margin: 0 auto;
        border-radius: 50%;
        /* Yorqinroq fon — ko'rinadigan */
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid rgba(255, 255, 255, 0.25);
        box-shadow:
            0 15px 35px -10px rgba(0, 0, 0, 0.5),
            0 0 0 6px rgba(255, 255, 255, 0.06);
        position: relative;
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    .how-circle span {
        font-size: 2rem;
        font-weight: 800;
        color: #ffffff;
        line-height: 1;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
    }

    .how-circle::after {
        content: "";
        position: absolute;
        inset: -10px;
        border-radius: 50%;
        border: 2px dashed rgba(255, 255, 255, 0.35);
        animation: howSpin 22s linear infinite;
    }

    .how-item:hover .how-circle {
        transform: translateY(-6px) scale(1.06);
        box-shadow:
            0 20px 45px -10px rgba(13, 110, 253, 0.7),
            0 0 0 8px rgba(255, 255, 255, 0.10);
    }

    @@keyframes howSpin {
        to { transform: rotate(360deg); }
    }

    /* ============================================================
       MATNLAR — ANIQ KO'RINADIGAN
    ============================================================ */
    .how-title {
        font-weight: 800;
        font-size: 1.05rem;
        color: #ffffff !important;
        margin: 22px 0 8px;
        line-height: 1.3;
        text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
    }

    .how-text {
        color: rgba(255, 255, 255, 0.78) !important;
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
        padding: 0 10px;
        font-weight: 400;
    }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @@media (max-width: 991px) {
        .how-wrapper::before {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .how-circle {
            width: 72px;
            height: 72px;
            border-width: 2px;
        }

        .how-circle span {
            font-size: 1.55rem;
        }

        .how-circle::after {
            inset: -8px;
        }

        .how-title {
            font-size: 0.98rem;
            margin-top: 18px;
        }

        .how-text {
            font-size: 0.84rem;
            padding: 0 4px;
        }
    }

    @@media (max-width: 576px) {
        .how-text {
            font-size: 0.8rem;
        }

        .how-title {
            font-size: 0.92rem;
        }
    }
</style>


<!-- ============================================================
     O'RNATISH (3 QADAM)
============================================================ -->
<section class="section steps-section">
    <div class="container">

        <div class="section-head text-center">
            <span class="section-eyebrow">Ishga tushirish tartibi</span>
            <h2 class="section-title">
                Atigi <span class="gradient-text">3 qadamda</span> kafengizni raqamlashtiring
            </h2>
            <p class="section-desc">
                SodiqCafe tizimini joriy qilish juda oson — biz jarayonning
                har bir bosqichida siz bilan birgamiz.
            </p>
        </div>

        <div class="steps-wrapper">

            <!-- STEP 1 -->
            <div class="step-item row align-items-center g-4">
                <div class="col-md-6 order-2 order-md-1">
                    <div class="step-content">
                        <h4 class="fw-bold text-primary mb-3">
                            Tizimga ulanish va menyu yaratish
                        </h4>
                        <p class="text-muted mb-0">
                            Siz uchun SodiqCafe tizimida admin panel ochamiz.
                            Barcha taomlar, rasmlar, narxlar va boshqa ma'lumotlarni
                            tizimga kiritasiz yoki bu ishni biz siz uchun amalga oshiramiz.
                        </p>
                    </div>
