                    <div class="step-visual">
                        <div class="step-icon-card">
                            <div class="fs-1"><i class="bi bi-laptop text-primary"></i></div>
                            <div class="step-icon-label">Admin Panel</div>
                        </div>
                        <div class="step-number">1</div>
                    </div>
                </div>
            </div>

            <!-- CONNECTOR -->
            <div class="step-connector d-none d-md-flex">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>

            <!-- STEP 2 -->
            <div class="step-item row align-items-center g-4">
                <div class="col-md-6">
                    <div class="step-visual">
                        <div class="step-icon-card">
                            <div class="fs-1"><i class="bi bi-phone text-primary"></i></div>
                            <div class="step-icon-label">NFC + QR</div>
                        </div>
                        <div class="step-number">2</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="step-content">
                        <h4 class="fw-bold text-primary mb-3">
                            NFC va QR kodlarni joylashtirish
                        </h4>
                        <p class="text-muted mb-0">
                            Har bir stol uchun maxsus NFC belgi va QR kod
                            tayyorlanadi. Mijoz telefonini NFC belgiga tekkizib
                            menyuni darhol ochishi yoki QR kod orqali kirishi mumkin.
                        </p>
                    </div>
                </div>
            </div>

            <!-- CONNECTOR -->
            <div class="step-connector d-none d-md-flex">
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>

            <!-- STEP 3 -->
            <div class="step-item row align-items-center g-4">
                <div class="col-md-6 order-2 order-md-1">
                    <div class="step-content">
                        <h4 class="fw-bold text-primary mb-3">
                            Xodimlarni o‘qitish va ishni boshlash
                        </h4>
                        <p class="text-muted mb-0">
                            Xodimlaringizga tizimdan foydalanishni tushuntiramiz.
                            Shundan so‘ng kafe raqamli menyu, Telegram bot
                            va bonus tizimidan foydalanishni boshlaydi.
                        </p>
                    </div>
                </div>
                <div class="col-md-6 order-1 order-md-2">
                    <div class="step-visual">
                        <div class="step-icon-card">
                            <div class="fs-1"><i class="bi bi-people text-primary"></i></div>
                            <div class="step-icon-label">Xizmat ko‘rsatish</div>
                        </div>
                        <div class="step-number">3</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>


