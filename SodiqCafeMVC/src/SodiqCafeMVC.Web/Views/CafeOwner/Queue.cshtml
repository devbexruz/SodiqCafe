@model List<SodiqCafeMVC.Domain.Entities.ServiceRequest>

@{
    ViewData["Title"] = "Navbat (Kutayotgan Mijozlar)";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold mb-1">🛎 Navbat (Buyurtmalar)</h2>
        <p class="text-muted mb-0">Hozirda kafeda xizmat ko'rsatishni kutayotgan mijozlar ro'yxati</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/cafe-owner/history" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-clock-history"></i> Bugungi tarix
        </a>
        <a href="/cafe-owner/customers" class="btn btn-primary shadow-sm">
            <i class="bi bi-people-fill"></i> Mijozlar bazasi
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4" id="queueList">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted">
            <i class="bi bi-people fs-1 d-block mb-3"></i>
            <p>Hozircha navbatda hech kim yo'q.</p>
        </div>
    }
    else
    {
        @foreach (var req in Model)
        {
            <div class="col-md-4 col-lg-3 request-item" id="req-@req.Id">
                <div class="card border-0 shadow-sm rounded-4 h-100 @(req.Status == SodiqCafeMVC.Domain.Enums.ServiceRequestStatus.Serving ? "border-primary border-2" : "")">
                    <div class="card-body text-center p-4">
                        <div class="display-3 fw-bold text-primary mb-3">#@req.DailyOrderNumber</div>
                        <h5 class="fw-semibold">@req.User?.Username</h5>
                        <div class="text-muted small mb-3">Kelgan vaqti: @req.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                        
                        <a asp-action="ServeCustomer" asp-route-requestId="@req.Id" class="btn btn-primary w-100 rounded-pill">
                            <i class="bi bi-play-circle"></i> Xizmat ko'rsatish
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        const cafeId = @ViewBag.SelectedCafeId;
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/nfc")
            .build();

        connection.on("NewCustomerArrived", function (data) {
            // Yangi mijoz kelganida sahifani yangilaymiz yoki DOMga qo'shamiz
            // Oddiylik uchun shunchaki sahifani yangilaymiz
            window.location.reload();
        });

        connection.start().then(function () {
            connection.invoke("JoinCafeGroup", cafeId).catch(function (err) {
                return console.error(err.toString());
            });
        }).catch(function (err) {
            return console.error(err.toString());
        });
    </script>
}
