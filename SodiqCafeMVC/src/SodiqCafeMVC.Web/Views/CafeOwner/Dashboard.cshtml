@model SodiqCafeMVC.Domain.Entities.Cafe

@{
    ViewData["Title"] = "Kafe Dashboard";
}

<style>
    .mobile-dashboard-container {
        padding-top: 1rem;
        padding-bottom: 5rem;
    }
    
    .premium-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        background: #ffffff;
        transition: transform 0.2s, box-shadow 0.2s;
        overflow: hidden;
        position: relative;
    }
    
    .premium-card:active {
        transform: scale(0.98);
    }
    
    .stat-value {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -1px;
    }

    .icon-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .gradient-balance { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: white; }
    .gradient-active { background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; }
    .gradient-products { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; }
    .gradient-customers { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; }
    .gradient-bonuses { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; }

    .glass-header {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        margin-bottom: 1.5rem;
    }
</style>

<div class="container mobile-dashboard-container">
    
    <div class="glass-header d-flex flex-column gap-2 mb-4">
        <div>
            <h1 class="h5 fw-bold mb-1 text-dark">Xush kelibsiz, @User.Identity?.Name!</h1>
            <p class="text-muted small mb-2">Boshqarilayotgan kafe:</p>
        </div>
        
        @{
            var userIdClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier);
            int userId = 0;
            if (userIdClaim != null) int.TryParse(userIdClaim.Value, out userId);
            
            var dbContext = Context.RequestServices.GetService(typeof(SodiqCafeMVC.Infrastructure.Data.AppDbContext)) as SodiqCafeMVC.Infrastructure.Data.AppDbContext;
            var userCafes = dbContext?.Cafes.Where(c => c.OwnerId == userId).ToList() ?? new List<SodiqCafeMVC.Domain.Entities.Cafe>();
        }

        @if (userCafes.Count > 1) {
            <select class="form-select form-select-lg fw-bold text-primary shadow-sm rounded-4 border-0" 
                    style="background-color: #f8f9fa; cursor: pointer;"
                    onchange="window.location.href='/cafe-owner/select-cafe/' + this.value;">
                @foreach(var c in userCafes) {
                    if (c.Id == Model.Id) {
                        <option value="@c.Id" selected>🏢 @c.Name</option>
                    } else {
                        <option value="@c.Id">🏢 @c.Name</option>
                    }
                }
            </select>
        } else {
            <div class="p-3 bg-light rounded-4 fw-bold text-primary shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-building"></i> @Model.Name
            </div>
        }
    </div>

    @if (!Model.IsActive)
    {
        <div class="premium-card mb-4" style="background: linear-gradient(135deg, #fee2e2 0%, #fef2f2 100%);">
            <div class="card-body p-4 d-flex align-items-center gap-3">
                <div class="fs-1">⚠️</div>
                <div>
                    <h5 class="fw-bold mb-1 text-danger">Kafe to'xtatilgan</h5>
                    <p class="mb-0 small text-danger">To'lov muddati tugagan yoki admin tomonidan to'xtatilgan.</p>
                </div>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="premium-card bg-primary text-white" style="background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%) !important;">
                <div class="card-body p-4 position-relative overflow-hidden">
                    <i class="bi bi-wallet2 position-absolute" style="font-size: 8rem; right: -20px; bottom: -20px; opacity: 0.1;"></i>
                    <h6 class="fw-semibold mb-3 text-white-50 text-uppercase letter-spacing-1">Joriy Balans</h6>
                    <h2 class="stat-value text-white mb-2">@(Model.Owner?.Balance.ToString("N0") ?? "0") <span class="fs-5 fw-normal text-white-50">UZS</span></h2>
                    <p class="mb-0 small text-white-50 d-flex align-items-center">
                        <i class="bi bi-info-circle me-1"></i> Oylik to'lov: @Model.BasePrice.ToString("N0") UZS
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6">
            <div class="premium-card h-100">
                <div class="card-body p-3 text-center">
                    <div class="icon-wrapper gradient-active mx-auto mb-3">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1 fs-5">@((Model.ActiveUntil - DateTime.UtcNow).Days)</h3>
                    <p class="text-muted small mb-0">kun qoldi</p>
                </div>
            </div>
        </div>
        
        <div class="col-6">
            <a asp-action="Products" class="text-decoration-none">
                <div class="premium-card h-100">
                    <div class="card-body p-3 text-center">
                        <div class="icon-wrapper gradient-products mx-auto mb-3">
                            <i class="bi bi-cup-hot"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1 fs-5">@(ViewBag.TotalProducts ?? 0)</h3>
                        <p class="text-muted small mb-0">mahsulotlar</p>
                    </div>
                </div>
            </a>
        </div>
        
        <div class="col-6">
            <a asp-action="Customers" class="text-decoration-none">
                <div class="premium-card h-100">
                    <div class="card-body p-3 text-center">
                        <div class="icon-wrapper gradient-customers mx-auto mb-3">
                            <i class="bi bi-people"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1 fs-5">@(ViewBag.TotalCustomers ?? 0)</h3>
                        <p class="text-muted small mb-0">mijozlar</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6">
            <a asp-action="History" class="text-decoration-none">
                <div class="premium-card h-100">
                    <div class="card-body p-3 text-center">
                        <div class="icon-wrapper gradient-bonuses mx-auto mb-3">
                            <i class="bi bi-gift"></i>
                        </div>
                        <h3 class="fw-bold text-dark mb-1 fs-5">@(ViewBag.TotalBonusesGiven ?? 0)</h3>
                        <p class="text-muted small mb-0">berilgan bonuslar</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
    
</div>

@section Scripts {
}
