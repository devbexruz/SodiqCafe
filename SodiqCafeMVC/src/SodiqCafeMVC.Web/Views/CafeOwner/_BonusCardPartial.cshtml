@model SodiqCafeMVC.Domain.Entities.BonusCampaign

@{
    var typeName = ((System.ComponentModel.DataAnnotations.DisplayAttribute?)Model.Type.GetType().GetField(Model.Type.ToString()!)?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false).FirstOrDefault())?.Name ?? Model.Type.ToString();
}

<div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(to right bottom, #ffffff, #f8f9fa);">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="fw-bold mb-0 text-primary">@Model.Name</h5>
            <div>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success rounded-pill px-3 py-2">Faol</span>
                }
                else
                {
                    <span class="badge bg-danger rounded-pill px-3 py-2">To'xtatilgan</span>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted small mb-3">@Model.Description</p>
        }
        
        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge bg-light text-dark border p-2"><i class="bi bi-tag-fill text-primary"></i> @typeName</span>
            <span class="badge bg-info text-dark bg-opacity-25 p-2"><i class="bi bi-flag-fill text-info"></i> Shart: @Model.ConditionValue</span>
            @if (Model.IsVisible)
            {
                <span class="badge bg-success bg-opacity-10 text-success p-2"><i class="bi bi-eye"></i> Ochiq</span>
            }
            else
            {
                <span class="badge bg-secondary bg-opacity-10 text-secondary p-2"><i class="bi bi-eye-slash"></i> Yashirin</span>
            }
        </div>
        
        <div class="p-3 bg-primary bg-opacity-10 rounded-3 mb-3 border border-primary border-opacity-25">
            <div class="text-primary fw-bold mb-1"><i class="bi bi-gift-fill me-2"></i>Mukofot</div>
            <div class="fs-6 fw-semibold text-dark">@Model.RewardDescription</div>
        </div>
        
        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
            <form asp-action="ToggleBonusCampaignActive" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="campaignId" value="@Model.Id" />
                @if (Model.IsActive)
                {
                    <button type="submit" class="btn btn-warning d-flex align-items-center gap-2 rounded-pill px-4"><i class="bi bi-pause-fill"></i> To'xtatish</button>
                }
                else
                {
                    <button type="submit" class="btn btn-success d-flex align-items-center gap-2 rounded-pill px-4"><i class="bi bi-play-fill"></i> Faollashtirish</button>
                }
            </form>
            <form asp-action="DeleteBonusCampaign" method="post" class="m-0" onsubmit="return confirm('Ushbu e\'lonni haqiqatan ham o\'chirasizmi?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="campaignId" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger rounded-circle p-2" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;"><i class="bi bi-trash"></i></button>
            </form>
        </div>
    </div>
</div>
