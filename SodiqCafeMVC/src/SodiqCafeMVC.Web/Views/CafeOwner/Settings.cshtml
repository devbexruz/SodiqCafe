@model SodiqCafeMVC.Domain.Entities.Cafe
@{
    ViewData["Title"] = "Sozlamalar";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-gear me-2"></i> @ViewData["Title"]</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-telegram text-primary me-2"></i> Telegram Bot Sozlamalari</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Mijozlarga bonuslarni yetkazib berish va bot orqali bog'lanish uchun Telegram bot tokenini kiriting.
                        Botning foydalanuvchi nomi (username) avtomatik ravishda aniqlanadi va Webhook o'rnatiladi.
                    </p>

                    @if (!string.IsNullOrEmpty(Model.TelegramBotUsername))
                    {
                        <div class="alert alert-info">
                            <strong>Faol Bot:</strong> 
                            <a href="https://t.me/@Model.TelegramBotUsername" target="_blank" class="text-decoration-none fw-bold">@@@Model.TelegramBotUsername</a>
                        </div>
                    }

                    <form asp-action="UpdateBotSettings" method="post">
                        <div class="mb-3">
                            <label for="botToken" class="form-label fw-bold">Bot Token (BotFather dan olingan)</label>
                            <input type="password" class="form-control" id="botToken" name="botToken" 
                                   value="@Model.TelegramBotToken" 
                                   placeholder="Masalan: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ..." />
                            <div class="form-text">Botni o'chirish uchun tokenni tozalab saqlang.</div>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-save me-1"></i> Saqlash
                        </button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-info-circle text-info me-2"></i> Ma'lumot</h5>
                </div>
                <div class="card-body">
                    <p><strong>BotFather da yangi bot ochish:</strong></p>
                    <ol class="small">
                        <li class="mb-2">Telegram da <a href="https://t.me/BotFather" target="_blank" class="text-decoration-none fw-bold">@@BotFather</a> ni toping.</li>
                        <li class="mb-2"><code>/newbot</code> komandasini yuboring.</li>
                        <li class="mb-2">Bot uchun nom kiriting.</li>
                        <li class="mb-2">Bot uchun username kiriting (masalan, <em>mening_kafem_bot</em>).</li>
                        <li class="mb-2">BotFather sizga <strong>HTTP API token</strong> beradi, o'sha tokenni nusxalab olib, bu yerga kiriting.</li>
                    </ol>
                    <div class="alert alert-warning small mb-0 mt-3">
                        <i class="bi bi-shield-lock me-1"></i> <strong>Eslatma:</strong> Tokeningizni hech kimga bermang, bu botingizni to'liq boshqarish imkonini beradi.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Logout Section -->
    <div class="row mt-4">
        <div class="col-12 text-center">
            <div class="card border-0 shadow-sm rounded-4 mb-4" style="background-color: rgba(220, 53, 69, 0.05); border: 1px solid rgba(220, 53, 69, 0.2) !important;">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-danger mb-3">Tizimdan Chiqish</h5>
                    <p class="text-muted mb-4">Siz tizimdan chiqish orqali hisobingizdan ssesiyani yakunlaysiz.</p>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm">
                        <i class="bi bi-box-arrow-right me-2"></i> Tizimdan Chiqish
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
