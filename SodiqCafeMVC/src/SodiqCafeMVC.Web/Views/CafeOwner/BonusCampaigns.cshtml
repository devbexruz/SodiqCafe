@model List<SodiqCafeMVC.Domain.Entities.BonusCampaign>

@{
    ViewData["Title"] = "Bonus E'lonlari (Aksiyalar)";
}

<div class="mb-4">
    <a href="/cafe-owner/products" class="btn btn-outline-secondary mb-3 rounded-pill px-3">
        <i class="bi bi-arrow-left"></i> Menyuga qaytish
    </a>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">🎁 Bonuslarni Boshqarish</h2>
            <p class="text-muted mb-0">@ViewBag.CafeName kafesi uchun bonuslarni sozlash</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addCampaignModal">
            <i class="bi bi-plus-lg"></i> Yangi Qo'shish
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 border-0 mb-4">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@{
    var activeBonuses = Model.Where(m => m.IsActive).ToList();
    var pausedBonuses = Model.Where(m => !m.IsActive).ToList();
}

<div class="row">
    <div class="col-12 mb-4">
        <h5 class="fw-bold text-success mb-3"><i class="bi bi-play-circle-fill me-2"></i>Faol Bonuslar</h5>
        @if (!activeBonuses.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body text-center py-4 text-muted">
                    Hozircha faol bonuslar yo'q
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in activeBonuses)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        @await Html.PartialAsync("_BonusCardPartial", item)
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-12 mb-4">
        <h5 class="fw-bold text-warning mb-3"><i class="bi bi-pause-circle-fill me-2"></i>To'xtatilgan Bonuslar</h5>
        @if (!pausedBonuses.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body text-center py-4 text-muted">
                    Hozircha to'xtatilgan bonuslar yo'q
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var item in pausedBonuses)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        @await Html.PartialAsync("_BonusCardPartial", item)
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Add Campaign Modal -->
<div class="modal fade" id="addCampaignModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold">Yangi Bonus E'loni</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="AddBonusCampaign" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nomi</label>
                        <input type="text" name="name" class="form-control" placeholder="Masalan: 10-chisi bepul!" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tavsifi (ixtiyoriy)</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Qo'shimcha shartlar yoki ma'lumotlar..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Bonus Turi</label>
                        <select name="type" class="form-select" required>
                            @foreach (var cat in Enum.GetValues(typeof(SodiqCafeMVC.Domain.Enums.BonusType)))
                            {
                                <option value="@cat">@(((System.ComponentModel.DataAnnotations.DisplayAttribute?)cat.GetType().GetField(cat.ToString()!)?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false).FirstOrDefault())?.Name ?? cat.ToString())</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Shart qiymati (Soni yoki Summa)</label>
                        <input type="number" name="conditionValue" class="form-control" placeholder="Masalan: 10 (marta) yoki 30000 (so'm)" required step="0.01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mukofot nimadan iborat?</label>
                        <input type="text" name="rewardDescription" class="form-control" placeholder="Masalan: 1 ta Kofe" required />
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="isVisible" id="isVisible" value="true" checked>
                        <label class="form-check-label fw-semibold ms-2" for="isVisible">Mijozlar ilovada buni ko'rishi mumkin</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Bekor qilish</button>
                    <button type="submit" class="btn btn-primary fw-bold">Saqlash</button>
                </div>
            </form>
        </div>
    </div>
</div>
