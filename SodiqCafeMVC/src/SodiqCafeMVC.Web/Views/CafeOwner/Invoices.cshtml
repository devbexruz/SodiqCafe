@model List<SodiqCafeMVC.Application.DTOs.InvoiceDto>

@{
    ViewData["Title"] = "Mening Invoyslarim";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Mening Invoyslarim</h2>
        <p class="text-muted mb-0">Kafe: @ViewBag.CafeName</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Invoys Raqami</th>
                        <th>Davr</th>
                        <th>Summa</th>
                        <th>Muddati</th>
                        <th>Holati</th>
                        <th class="text-end pe-4">Harakatlar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var invoice in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-primary">#@invoice.InvoiceNumber</td>
                                <td>@invoice.PeriodStart.ToString("dd.MM.yyyy") - @invoice.PeriodEnd.ToString("dd.MM.yyyy")</td>
                                <td class="fw-bold">@invoice.Amount.ToString("N0") UZS</td>
                                <td>
                                    <span class="text-danger">@invoice.DueDate.ToString("dd.MM.yyyy")</span>
                                </td>
                                <td>
                                    @if (invoice.Status == SodiqCafeMVC.Domain.Enums.InvoiceStatus.Paid)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">To'langan</span>
                                    }
                                    else if (invoice.Status == SodiqCafeMVC.Domain.Enums.InvoiceStatus.Pending)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-2">Kutilmoqda / Tekshirilmoqda</span>
                                    }
                                    else if (invoice.Status == SodiqCafeMVC.Domain.Enums.InvoiceStatus.Overdue)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">Muddati o'tgan</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (invoice.Status != SodiqCafeMVC.Domain.Enums.InvoiceStatus.Paid)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" 
                                                data-bs-toggle="modal" data-bs-target="#uploadReceiptModal-@invoice.Id">
                                            <i class="bi bi-upload me-1"></i> To'lov qilish
                                        </button>
                                        
                                        <!-- Upload Modal -->
                                        <div class="modal fade" id="uploadReceiptModal-@invoice.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content rounded-4 border-0 shadow">
                                                    <div class="modal-header border-bottom-0 pb-0">
                                                        <h5 class="modal-title fw-bold">Kvitansiya yuklash</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body text-start">
                                                        <p class="text-muted mb-4">Iltimos, #@invoice.InvoiceNumber raqamli invoys uchun to'lov kvitansiyasini (rasmini) yuklang.</p>
                                                        <form asp-action="UploadReceipt" asp-controller="CafeOwner" method="post" enctype="multipart/form-data">
                                                            <input type="hidden" name="invoiceId" value="@invoice.Id" />
                                                            <div class="mb-4 text-center">
                                                                <div class="upload-area p-4 border border-2 border-dashed rounded-4 bg-light mb-3 position-relative" style="cursor:pointer;" onclick="document.getElementById('receiptImage-@invoice.Id').click()">
                                                                    <i class="bi bi-cloud-arrow-up display-4 text-secondary mb-2"></i>
                                                                    <p class="mb-0 fw-semibold text-secondary">Rasmni tanlash uchun bosing</p>
                                                                    <input type="file" name="receiptImage" id="receiptImage-@invoice.Id" class="d-none" accept="image/*" required onchange="previewImage(this, 'preview-@invoice.Id')" />
                                                                </div>
                                                                <img id="preview-@invoice.Id" src="#" alt="Preview" class="img-fluid rounded-3 shadow-sm d-none" style="max-height: 200px; object-fit: cover;" />
                                                            </div>
                                                            <div class="d-grid">
                                                                <button type="submit" class="btn btn-primary rounded-pill py-2">Yuklash va yuborish</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt display-4 mb-3 d-block text-secondary opacity-50"></i>
                                Hozircha invoyslar yo'q
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input, previewId) {
            var preview = document.getElementById(previewId);
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    input.parentElement.classList.add('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
