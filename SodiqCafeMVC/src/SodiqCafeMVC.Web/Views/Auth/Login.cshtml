@model LoginDto
@{
    ViewData["Title"] = "Tizimga kirish";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="text-center mb-5">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none d-inline-flex align-items-center gap-2 mb-3">
                <img src="~/favicon.png" alt="SodiqCafe Logo" style="height: 48px; object-fit: contain;" />
                <span class="fs-2 fw-bold text-dark">Sodiq<span class="text-primary">Cafe</span></span>
            </a>
            <p class="text-muted fs-5">Xush kelibsiz! Tizimga kirish uchun ma'lumotlaringizni kiriting.</p>
        </div>

        <div class="card shadow-sm border-0 rounded-4" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px);">
            <div class="card-body p-4 p-md-5">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 rounded-3 d-flex align-items-center gap-3 mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        <div asp-validation-summary="All" class="mb-0 small"></div>
                    </div>
                }

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="form-floating mb-4">
                        <input asp-for="UsernameOrEmail" class="form-control rounded-3" placeholder="admin yoki pochta" required autofocus style="background: #f8f9fa; border: 1px solid #eef0f5;" />
                        <label asp-for="UsernameOrEmail" class="text-muted"><i class="bi bi-person me-2"></i> Foydalanuvchi nomi yoki Email</label>
                        <span asp-validation-for="UsernameOrEmail" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Parolingizni kiriting" required style="background: #f8f9fa; border: 1px solid #eef0f5;" />
                        <label asp-for="Password" class="text-muted"><i class="bi bi-lock me-2"></i> Parol</label>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-grid mt-5">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm" style="transition: all 0.3s; padding: 12px;">
                            Tizimga kirish <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="/#contact" class="text-muted text-decoration-none small hover-primary" style="transition: 0.2s;">
                Hisobingiz yo'qmi? Biz bilan bog'laning.
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
