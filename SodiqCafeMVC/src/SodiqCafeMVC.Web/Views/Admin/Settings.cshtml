@model SodiqCafeMVC.Domain.Entities.SystemSettings
@{
    ViewData["Title"] = "Global Sozlamalar";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1 text-dark">⚙️ Tizim Sozlamalari</h2>
        <p class="text-muted mb-0">Platforma bo'ylab amal qiladigan asosiy narxlar va limitlarni sozlash</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <strong>Muvaffaqiyatli!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-currency-dollar text-primary me-2"></i> Narxlar va Limitlar</h5>
                </div>
                <div class="card-body p-4 pt-0">
                    <form asp-action="UpdateSettings" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Asosiy limitgacha oylik to'lov (UZS)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">💰</span>
                                    <input type="number" name="basePrice" class="form-control border-start-0 ps-0" value="@Model.BasePrice" required min="0" step="1000">
                                </div>
                                <div class="form-text">Barcha kafelar uchun standart oylik to'lov.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Asosiy foydalanuvchilar limiti</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">👥</span>
                                    <input type="number" name="baseUsersLimit" class="form-control border-start-0 ps-0" value="@Model.BaseUsersLimit" required min="1">
                                </div>
                                <div class="form-text">Asosiy to'lov ichiga kiruvchi aktiv foydalanuvchilar soni.</div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Qo'shimcha paket narxi (UZS)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">➕</span>
                                    <input type="number" name="pricePerExtraUsers" class="form-control border-start-0 ps-0" value="@Model.PricePerExtraUsers" required min="0" step="1000">
                                </div>
                                <div class="form-text">Limitdan oshgan har bir qo'shimcha paket uchun narx.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Qo'shimcha paket hajmi (qadam)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">📈</span>
                                    <input type="number" name="extraUsersStep" class="form-control border-start-0 ps-0" value="@Model.ExtraUsersStep" required min="1">
                                </div>
                                <div class="form-text">Bitta qo'shimcha paket nechta foydalanuvchini o'z ichiga oladi.</div>
                            </div>

                            <div class="col-12 mt-4 text-end">
                                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                    <i class="bi bi-save me-1"></i> O'zgarishlarni Saqlash
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary bg-gradient text-white">
                <div class="card-body p-4 text-center">
                    <div class="fs-1 mb-3">🍔</div>
                    <h5 class="fw-bold mb-3">Shablon Mahsulotlar</h5>
                    <p class="small text-white-50 mb-4">
                        Kafelar uchun dastlabki qo'shiladigan tayyor mahsulot shablonlarini boshqarish.
                    </p>
                    <a asp-action="Templates" class="btn btn-light rounded-pill px-4 fw-bold text-primary w-100">
                        Shablonlarni Sozlash <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
    </div>
    
    <!-- Logout Section -->
    <div class="row mt-4">
        <div class="col-12 text-center">
            <div class="card border-0 shadow-sm rounded-4 mb-4" style="background-color: rgba(220, 53, 69, 0.05); border: 1px solid rgba(220, 53, 69, 0.2) !important;">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-danger mb-3">Tizimdan Chiqish</h5>
                    <p class="text-muted mb-4">Siz tizimdan chiqish orqali hisobingizdan ssesiyani yakunlaysiz.</p>
                    <a asp-controller="Auth" asp-action="Logout" class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm">
                        <i class="bi bi-box-arrow-right me-2"></i> Tizimdan Chiqish
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
