@model IEnumerable<SodiqCafeMVC.Domain.Entities.User>
@{
    ViewData["Title"] = "Kafe egalari";
}

<div class="container-fluid py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-dark">👤 Kafe egalari ro'yxati</h2>
            <p class="text-muted mb-0">Tizimdagi barcha kafe egalari va ularning balansi</p>
        </div>
        <a asp-action="RegisterOwner" class="btn btn-primary shadow-sm rounded-pill px-4 fw-semibold">
            <i class="fs-5 me-1">+</i> Yangi egasini ro'yxatdan o'tkazish
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <strong>Muvaffaqiyatli!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <strong>Xatolik!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 text-uppercase text-secondary small fw-bold">ID</th>
                            <th class="py-3 text-uppercase text-secondary small fw-bold">Ismi va Login</th>
                            <th class="py-3 text-uppercase text-secondary small fw-bold">Telefon</th>
                            <th class="py-3 text-uppercase text-secondary small fw-bold text-center">Kafelar soni</th>
                            <th class="py-3 text-uppercase text-secondary small fw-bold text-end">Balans (UZS)</th>
                            <th class="py-3 text-uppercase text-secondary small fw-bold text-end pe-4">Amallar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="fs-1 mb-3">👻</div>
                                    <h5>Hali hech qanday kafe egasi tizimga kiritilmagan.</h5>
                                    <p>Tizimga yangi kafe egasi qo'shish uchun yuqoridagi tugmani bosing.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var owner in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="text-muted fw-semibold">#@owner.Id</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 40px; height: 40px;">
                                                @(owner.FullName?.Substring(0, 1).ToUpper() ?? owner.Username.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@owner.FullName</div>
                                                <div class="small text-muted">@owner.Username</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-dark">@owner.PhoneNumber</div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-2">
                                            @owner.Cafes.Count ta kafe
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-bold @(owner.Balance > 0 ? "text-success" : "text-secondary") fs-6">
                                            @owner.Balance.ToString("N0") <small class="fw-normal text-muted">so'm</small>
                                        </div>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="OwnerDetail" asp-route-id="@owner.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            Batafsil
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
