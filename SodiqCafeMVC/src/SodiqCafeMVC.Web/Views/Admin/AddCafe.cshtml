@model SodiqCafeMVC.Application.DTOs.RegisterCafeDto
@{
    ViewData["Title"] = "Foydalanuvchiga yangi kafe qo'shish";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold mb-0 text-primary"><i class="bi bi-shop"></i> Mavjud foydalanuvchiga yangi kafe qo'shish</h3>
                <a asp-action="OwnerDetail" asp-route-id="@ViewBag.OwnerId" class="btn btn-outline-secondary btn-sm">← Egasining profiliga qaytish</a>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-dark text-white p-3 rounded-top-4">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-warning text-dark me-2">Faqat Admin</span>
                        <span class="small">Admin orqali yangi kafe qo'shish</span>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form asp-action="AddCafe" asp-route-ownerId="@ViewBag.OwnerId" method="post">
                        
                        <div class="bg-light p-3 rounded-3 mb-4 border">
                            <h5 class="fw-bold text-dark mb-3">🏪 Kafe ma'lumotlari</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="CafeName" class="form-label fw-semibold">Kafe nomi</label>
                                    <input asp-for="CafeName" class="form-control" placeholder="Sodiq Cafe Chilonzor" />
                                    <span asp-validation-for="CafeName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="CafePhone" class="form-label fw-semibold">Kafe telefon raqami</label>
                                    <input asp-for="CafePhone" class="form-control" placeholder="+998901112233" />
                                    <span asp-validation-for="CafePhone" class="text-danger small"></span>
                                    <div class="form-text">Agar ko'rsatilmasa, egasining telefon raqami olinadi.</div>
                                </div>
                                <div class="col-12">
                                    <label asp-for="CafeAddress" class="form-label fw-semibold">Kafe manzili</label>
                                    <input asp-for="CafeAddress" class="form-control" placeholder="Toshkent sh., Chilonzor tumani, 9-mavze" />
                                    <span asp-validation-for="CafeAddress" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Moliyaviy va obuna ma'lumotlari -->
                        <div class="bg-primary bg-opacity-10 p-3 rounded-3 mb-4 border border-primary border-opacity-25">
                            <h5 class="fw-bold text-primary mb-3">💳 To'lov va obuna shartlari</h5>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="BasePrice" class="form-label fw-semibold text-primary">Oylik xizmat narxi (so'm)</label>
                                    <div class="input-group">
                                        <input asp-for="BasePrice" class="form-control border-primary" type="number" step="10000" min="0" />
                                        <span class="input-group-text bg-white border-primary text-primary fw-bold">UZS</span>
                                    </div>
                                    <span asp-validation-for="BasePrice" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="alert alert-warning mt-3 mb-0 small border border-warning">
                                <strong>Diqqat:</strong> Yangi kafe qo'shilganda tizim avtomatik ravishda 1 oylik faol muddat beradi va shu oy uchun invoys (to'lov varaqasi) yaratadi. Agar egasining balansida yetarli mablag' bo'lsa, to'lov darhol yechiladi.
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill">
                                ➕ Kafeni qo'shish
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
