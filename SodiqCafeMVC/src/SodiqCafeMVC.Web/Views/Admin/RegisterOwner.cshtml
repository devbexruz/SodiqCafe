@model SodiqCafeMVC.Application.DTOs.RegisterOwnerDto
@{
    ViewData["Title"] = "Kafe egasini ro'yxatdan o'tkazish (Admin)";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="fw-bold mb-0 text-primary">👤 Kafe egasini ro'yxatdan o'tkazish</h3>
                <a asp-action="Owners" class="btn btn-outline-secondary btn-sm">← Egalar ro'yxatiga qaytish</a>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-dark text-white p-3 rounded-top-4">
                    <div class="d-flex align-items-center">
                        <span class="badge bg-warning text-dark me-2">Faqat Admin</span>
                        <span class="small">Admin orqali yangi egasini tizimga qo'shish</span>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div asp-validation-summary="All" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form asp-action="RegisterOwner" method="post">
                        
                        <div class="bg-light p-3 rounded-3 mb-4 border">
                            <h5 class="fw-bold text-dark mb-3">Shaxsiy ma'lumotlar</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-semibold">F.I.SH (To'liq ismi)</label>
                                    <input asp-for="FullName" class="form-control" placeholder="Masalan: Sardor Rahimov" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon raqami</label>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="+998901234567" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Username" class="form-label fw-semibold">Foydalanuvchi nomi (Login)</label>
                                    <input asp-for="Username" class="form-control" placeholder="sardor_cafe" />
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-semibold">Elektron pochta</label>
                                    <input asp-for="Email" class="form-control" type="email" placeholder="sardor@example.com" />
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Password" class="form-label fw-semibold">Parol</label>
                                    <input asp-for="Password" class="form-control" type="password" placeholder="********" />
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="InitialBalance" class="form-label fw-semibold">Dastlabki balans (so'mda)</label>
                                    <input asp-for="InitialBalance" class="form-control" type="number" step="1000" min="0" />
                                    <span asp-validation-for="InitialBalance" class="text-danger small"></span>
                                    <div class="form-text">Foydalanuvchiga bonus tariqasida dastlabki balans berish mumkin.</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill">
                                ➕ Kafe egasini yaratish
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
