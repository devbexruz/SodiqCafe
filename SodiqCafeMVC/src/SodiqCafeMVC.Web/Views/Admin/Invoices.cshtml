@model List<InvoiceDto>
@{
    ViewData["Title"] = "Admin Panel - Invoyslar va Oylik To'lovlar";
    var summary = ViewBag.Summary as BillingSummaryDto ?? new BillingSummaryDto();
    var selectedCafeId = ViewBag.SelectedCafeId as int?;
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1 text-dark">📑 Invoyslar va Oylik To'lovlar</h2>
            <p class="text-muted mb-0">
                Har oyning 1-sanasidan oxirgi sanasigacha hisoblangan oylik invoyslar va ularning to'lov holati
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Cafes" class="btn btn-outline-secondary fw-semibold shadow-sm">
                ← Kafelarga qaytish
            </a>
            <form asp-action="GenerateMonthlyInvoices" method="post" class="d-inline" onsubmit="return confirm('Barcha kafelar uchun oylik invoyslarni yangilash/chiqarishni tasdiqlaysizmi?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary fw-bold shadow-sm">
                    ⚡ Yangi oylik invoyslar chiqarish
                </button>
            </form>
        </div>
    </div>

    <!-- Bildirishnomalar -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">✓</span>
                <div>@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
            <div class="d-flex align-items-center">
                <span class="fs-4 me-2">⚠</span>
                <div>@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Invoys statistikasi -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-warning">
                <div class="text-muted small fw-semibold text-uppercase">Kutilayotgan Invoyslar</div>
                <div class="fs-3 fw-bold text-warning my-1">@summary.PendingInvoicesCount ta</div>
                <div class="small text-muted">@summary.TotalPendingInvoicesAmount.ToString("N0") so'm</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-success">
                <div class="text-muted small fw-semibold text-uppercase">To'langan Summa</div>
                <div class="fs-3 fw-bold text-success my-1">@summary.TotalPaidAmount.ToString("N0") <small class="fs-6 text-muted">so'm</small></div>
                <div class="small text-muted">Muvaffaqiyatli to'langan</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-info">
                <div class="text-muted small fw-semibold text-uppercase">Depozit Balans</div>
                <div class="fs-3 fw-bold text-info my-1">@summary.TotalCafesBalance.ToString("N0") <small class="fs-6 text-muted">so'm</small></div>
                <div class="small text-muted">Avto-yechilish uchun mavjud</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white border-start border-4 border-dark">
                <div class="text-muted small fw-semibold text-uppercase">Invoys Davri</div>
                <div class="fs-5 fw-bold text-dark my-1">1-kundan oxirgi kungacha</div>
                <div class="small text-muted">Avto muddat: +1 oy</div>
            </div>
        </div>
    </div>

    <!-- Invoyslar jadvali -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                @if (selectedCafeId.HasValue)
                {
                    <span>Kafe #@selectedCafeId bo'yicha Invoyslar</span>
                }
                else
                {
                    <span>Barcha Invoyslar Ro'yxati</span>
                }
            </h5>
            @if (selectedCafeId.HasValue)
            {
                <a asp-action="Invoices" class="btn btn-sm btn-outline-secondary">Barcha kafelarni ko'rsatish</a>
            }
        </div>
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted fs-5">Hozircha hech qanday invoys mavjud emas.</p>
                    <form asp-action="GenerateMonthlyInvoices" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">Oylik invoyslarni chiqarish</button>
                    </form>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Invoys #</th>
                                <th>Kafe Nomi</th>
                                <th>Egasi</th>
                                <th>Davr (Oyning 1-kuni - Oxirgi kuni)</th>
                                <th>Summa</th>
                                <th>To'lov muddati</th>
                                <th>Holat</th>
                                <th class="text-end pe-4">Amallar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var inv in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <code class="fw-bold text-primary fs-6">@inv.InvoiceNumber</code>
                                        <div class="small text-muted">@inv.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@inv.CafeName</div>
                                        <small class="text-muted">ID: #@inv.CafeId</small>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">👤 @inv.OwnerName</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">
                                            📅 @inv.PeriodStart.ToString("dd.MM.yyyy") - @inv.PeriodEnd.ToString("dd.MM.yyyy")
                                        </div>
                                        <small class="text-muted">Oy davomidagi to'liq xizmat</small>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark fs-6">
                                            @inv.Amount.ToString("N0") <small class="fw-normal text-muted">so'm</small>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-muted">@inv.DueDate.ToString("dd.MM.yyyy")</div>
                                    </td>
                                    <td>
                                        @if (inv.Status == InvoiceStatus.Paid)
                                        {
                                            <span class="badge bg-success px-3 py-2 rounded-pill">
                                                ✓ To'langan (@inv.PaidAt?.ToLocalTime().ToString("dd.MM.yyyy"))
                                            </span>
                                        }
                                        else if (inv.Status == InvoiceStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                                ⏳ To'lov kutilmoqda
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                                @inv.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (inv.Status == InvoiceStatus.Pending)
                                        {
                                            if (inv.CanBePaid)
                                            {
                                                <form asp-action="PayInvoice" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="invoiceId" value="@inv.Id" />
                                                    <button type="submit" class="btn btn-success btn-sm fw-bold shadow-sm">
                                                        💳 Balansdan to'lash (+1 oy)
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <a asp-action="Cafes" class="btn btn-outline-warning btn-sm">
                                                    💰 Balansni to'ldirish
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-success small fw-semibold">
                                                ✓ Faollik uzaytirilgan
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
