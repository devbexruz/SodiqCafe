@model SodiqCafeMVC.Domain.Entities.Cafe
@{
    ViewData["Title"] = "Kafe faoliyati vaqtincha to'xtatilgan";
}

<div class="container my-5 py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 p-4 p-md-5">
                <div class="mb-4">
                    <span class="badge bg-danger p-3 rounded-circle fs-1 shadow-sm">
                        ⏳
                    </span>
                </div>

                <h3 class="fw-bold text-danger mb-2">Kafe faoliyati vaqtincha to'xtatilgan</h3>
                <h5 class="text-secondary mb-4">@(Model?.Name ?? "Ushbu kafe")</h5>

                <div class="alert alert-warning border-0 text-start rounded-3 p-3 mb-4">
                    <p class="mb-1 fw-bold">⚠️ Hurmatli mijoz yoki kafe ma'muriyati:</p>
                    <p class="mb-0 small text-muted">
                        Ushbu kafening oylik abonent obunasi muddati tugagan yoki to'lov qilinmaganligi sababli menyu xizmati vaqtincha cheklangan.
                    </p>
                </div>

                <div class="bg-light p-3 rounded-3 mb-4 text-start small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Faollik muddati:</span>
                        <span class="fw-bold text-danger">@(Model?.ActiveUntil.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "Muddati o'tgan")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Holat:</span>
                        <span class="badge bg-danger">Vaqtincha to'xtatilgan</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Qayta faollashtirish:</span>
                        <span class="text-dark">Oylik invoys to'langach avtomatik ishga tushadi</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary fw-bold py-2 rounded-3">
                        🔐 Kafe egasi / Admin sifatida kirish
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary py-2 rounded-3">
                        Bosh sahifaga qaytish
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
